def cmd_control_remove(a):
    out(send("ai_remove_control", clean(index=a.index, region_index=a.region)))


def build_parser():
    p = argparse.ArgumentParser(
        prog="kri",
        description="CLI bridge to Krita (kritamcp plugin). Prints JSON; errors exit 1.",
    )
    sub = p.add_subparsers(dest="cmd", required=True, metavar="command")

    def _place(sp, what="the layer"):
        g = sp.add_mutually_exclusive_group()
        g.add_argument("--above", metavar="REF", help=f"put {what} right above REF")
        g.add_argument("--below", metavar="REF", help=f"put {what} right below REF")
        g.add_argument("--into", metavar="GROUP", help=f"put {what} on top inside GROUP")
        g.add_argument("--top", action="store_true", default=None,
                       help="top of the whole stack")
        g.add_argument("--bottom", action="store_true", default=None,
                       help="bottom of the whole stack")

    def _look(sp):
        sp.add_argument("--blend", metavar="MODE",
                        help="blending mode id or alias (kri layer blends)")
        sp.add_argument("--opacity", type=float, metavar="PCT",
                        help="opacity 0-100")

    sp = sub.add_parser("health", help="check the plugin is up")
    sp.set_defaults(fn=cmd_health)

    sp = sub.add_parser("status", help="document + full AI state in one round-trip")
    sp.set_defaults(fn=cmd_status)

    sp = sub.add_parser("undo", help="undo last action")
    sp.set_defaults(fn=cmd_undo)

    sp = sub.add_parser("canvas", help="create a new canvas: kri canvas W H")
    sp.add_argument("width", type=int)
    sp.add_argument("height", type=int)
    sp.add_argument("--name", default="New Canvas")
    sp.add_argument("--bg", default="#1a1a2e")
    sp.set_defaults(fn=cmd_canvas)

    sp = sub.add_parser("color", help="set foreground color (hex)")
    sp.add_argument("color")
    sp.set_defaults(fn=cmd_color)

    sp = sub.add_parser("brush", help="set brush preset/size/opacity")
    sp.add_argument("--preset")
    sp.add_argument("--size", type=int)
    sp.add_argument("--opacity", type=float)
    sp.set_defaults(fn=cmd_brush)

    sp = sub.add_parser("stroke", help="polyline: kri stroke 100,100 150,120")
    sp.add_argument("points", nargs="+", metavar="X,Y")
    sp.add_argument("--size", type=int)
    sp.add_argument("--feather", type=float, default=0.0)
    sp.add_argument("--opacity", type=float, default=1.0)
    sp.set_defaults(fn=cmd_stroke)

    sp = sub.add_parser("fill", help="fill a circle: kri fill X Y [RADIUS]")
    sp.add_argument("x", type=int)
    sp.add_argument("y", type=int)
    sp.add_argument("radius", type=int, nargs="?", default=50)
    sp.add_argument("--feather", type=float, default=0.0)
    sp.set_defaults(fn=cmd_fill)

    sp = sub.add_parser("shape", help="draw rectangle/ellipse/line")
    sp.add_argument("shape", choices=["rectangle", "ellipse", "line"])
    sp.add_argument("x", type=int)
    sp.add_argument("y", type=int)
    sp.add_argument("width", type=int, nargs="?", default=100)
    sp.add_argument("height", type=int, nargs="?", default=100)
    sp.add_argument("--no-fill", action="store_true")
    sp.add_argument("--stroke", action="store_true")
    sp.add_argument("--feather", type=float, default=0.0)
    sp.add_argument("--x2", type=int)
    sp.add_argument("--y2", type=int)
    sp.add_argument("--line-width", type=int, dest="line_width")
    sp.set_defaults(fn=cmd_shape)

    sp = sub.add_parser("redo", help="redo last undone action")
    sp.set_defaults(fn=cmd_redo)

    sp = sub.add_parser("clear", help="clear canvas to a color")
    sp.add_argument("color", nargs="?", default="#1a1a2e")
    sp.set_defaults(fn=cmd_clear)

    sp = sub.add_parser("save", help="export canvas to a file")
    sp.add_argument("path")
    sp.set_defaults(fn=cmd_save)

    sp = sub.add_parser("open", help="open a file in Krita")
    sp.add_argument("path")
    sp.set_defaults(fn=cmd_open)

    sp = sub.add_parser("color-at", help="eyedropper at X Y")
    sp.add_argument("x", type=int)
    sp.add_argument("y", type=int)
    sp.set_defaults(fn=cmd_color_at)

    sp = sub.add_parser("brushes", help="list brush presets")
    sp.add_argument("filter", nargs="?", default="")
    sp.add_argument("--limit", type=int, default=20)
    sp.set_defaults(fn=cmd_brushes)

    sp = sub.add_parser("look", help="save canvas image to a file, print its path")
    sp.add_argument("--full", action="store_true",
                    help="full-res PNG (default: fast downscaled JPEG)")
    sp.add_argument("--max-dim", type=int, default=None, dest="max_dim",
                    help="downscale cap in px for fast mode (plugin default 512)")
    sp.add_argument("-o", "--out")
    sp.set_defaults(fn=cmd_look)

    sp = sub.add_parser("batch",
                        help="run many commands in one round-trip (JSON file or stdin)")
    sp.add_argument("file", nargs="?", default="-")
    sp.add_argument("--look", choices=["fast", "full"],
                    help="also return the final canvas image")
    sp.add_argument("-o", "--out")
    sp.set_defaults(fn=cmd_batch)

    sp = sub.add_parser("exec",
                        help="run Python inside Krita (needs KRITAMCP_ALLOW_EXEC=1)")
    sp.add_argument("file", nargs="?", default="-",
                    help="script path, or '-' for stdin (default)")
    sp.add_argument("--timeout", type=float, default=30.0)
    sp.set_defaults(fn=cmd_exec)

    sel = sub.add_parser(
        "select", help="canvas selections (AI generate inpaints inside them)"
    ).add_subparsers(dest="select_cmd", required=True, metavar="select-command")

    def _sel_mode(sp):
        sp.add_argument("--mode", default="replace",
                        choices=["replace", "add", "subtract", "intersect"],
                        help="combine with the existing selection")

    sp = sel.add_parser("rect", help="rectangular selection: kri select rect X Y W H")
    sp.add_argument("x", type=int)
    sp.add_argument("y", type=int)
    sp.add_argument("width", type=int)
    sp.add_argument("height", type=int)
    _sel_mode(sp)
    sp.set_defaults(fn=cmd_select_rect)

    sp = sel.add_parser("ellipse", help="elliptical selection in bounding box X Y W H")
    sp.add_argument("x", type=int)
    sp.add_argument("y", type=int)
    sp.add_argument("width", type=int)
    sp.add_argument("height", type=int)
    _sel_mode(sp)
    sp.set_defaults(fn=cmd_select_ellipse)

    sp = sel.add_parser("poly", help="polygon selection: kri select poly X,Y X,Y X,Y ...")
    sp.add_argument("points", nargs="+", metavar="X,Y")
    _sel_mode(sp)
    sp.set_defaults(fn=cmd_select_poly)

    sp = sel.add_parser("all", help="select the whole canvas")
    sp.set_defaults(fn=cmd_select_all)

    sp = sel.add_parser("none", help="deselect (clear the selection)")
    sp.set_defaults(fn=cmd_select_none)

    sp = sel.add_parser("invert", help="invert the current selection")
    sp.set_defaults(fn=cmd_select_invert)

    for op, hlp in [("feather", "soften the selection edge by RADIUS px"),
                    ("grow", "expand the selection by RADIUS px"),
                    ("shrink", "contract the selection by RADIUS px"),
                    ("border", "keep only a RADIUS px band along the edge")]:
        sp = sel.add_parser(op, help=hlp)
        sp.add_argument("radius", type=int)
        sp.set_defaults(fn=cmd_select_modify, op=op)

    sp = sel.add_parser("info", help="bounds of the current selection")
    sp.set_defaults(fn=cmd_select_info)

    sp = sel.add_parser(
        "sam", help="AI selection via SAM 3 (krita-autoselect daemon): "
                    "text concept, clicks and/or box")
    sp.add_argument("text", nargs="?", default=None,
                    help="concept prompt, e.g. 'the red car'")
    sp.add_argument("--point", action="append", metavar="X,Y",
                    help="include this click (repeatable)")
    sp.add_argument("--neg-point", action="append", metavar="X,Y",
                    dest="neg_point", help="exclude this click (repeatable)")
    sp.add_argument("--box", nargs=4, type=int, metavar=("X", "Y", "W", "H"))
    sp.add_argument("--within", nargs=4, type=int, metavar=("X", "Y", "W", "H"),
                    help="with TEXT: keep only instances inside this region; "
                         "alone: the object inside it")
    sp.add_argument("--threshold", type=float, default=None,
                    help="instance score threshold (daemon default 0.5)")
    sp.add_argument("--instance", type=int, default=None,
                    help="pick ONE instance by rank (0 = best score); "
                         "default: union of all matches")
    sp.add_argument("--list", action="store_true",
                    help="only print instances (score + bbox), don't select")
    sp.add_argument("--timeout", type=float, default=120.0,
                    help="seconds to wait (first call loads the model)")
    sp.add_argument("--to-layer", metavar="NAME", dest="to_layer",
                    help="also create a paint layer NAME filled with --color "
                         "inside the new selection")
    sp.add_argument("--color", metavar="HEX",
                    help="fill colour for --to-layer (default #ffffff)")
    _look(sp)
    _place(sp, "the --to-layer layer")
    sp.add_argument("--save-mask", metavar="NAME", dest="save_mask",
                    help="also store the selection as a selection mask NAME "
                         "(on the --to-layer layer, else the active one)")
    _sel_mode(sp)
    sp.set_defaults(fn=cmd_select_sam)

    sp = sel.add_parser("from-mask",
                        help="selection from a grayscale mask image file")
    sp.add_argument("file")
    _sel_mode(sp)
    sp.set_defaults(fn=cmd_select_from_mask)

    sp = sel.add_parser("from-layer",
                        help="selection from a layer's alpha (Select Opaque)")
    sp.add_argument("ref", metavar="REF")
    _sel_mode(sp)
    sp.set_defaults(fn=cmd_select_from_layer)

    sp = sel.add_parser("save", help="store the selection as a named "
                                     "selection mask on a layer")
    sp.add_argument("name")
    sp.add_argument("--on", metavar="REF",
                    help="layer that holds the mask (default: active layer)")
    sp.set_defaults(fn=cmd_select_save)

    sp = sel.add_parser("load", help="restore a selection saved with "
                                     "`kri select save`")
    sp.add_argument("name", help="selection mask name, path or id")
    _sel_mode(sp)
    sp.set_defaults(fn=cmd_select_load)

    lay = sub.add_parser(
        "layer", help="layers: list/new/import/export/set/move/group/fill..."
    ).add_subparsers(dest="layer_cmd", required=True, metavar="layer-command")
    ref_help = "layer: unique name, Group/Sub/Layer path or id"

    sp = lay.add_parser("list", help="layer tree, top to bottom, with properties")
    sp.set_defaults(fn=cmd_layer_list)

    sp = lay.add_parser("blends", help="valid blending modes and aliases")
    sp.set_defaults(fn=cmd_layer_blends)

    sp = lay.add_parser("new", help="new paint/group layer (becomes active)")
    sp.add_argument("name")
    sp.add_argument("--type", choices=["paint", "group"], default=None)
    _place(sp)
    _look(sp)
    sp.add_argument("--hidden", action="store_true")
    sp.add_argument("--color", metavar="HEX", help="fill the layer with it")
    sp.add_argument("--selection", action="store_true",
                    help="with --color: fill only inside the current selection")
    sp.set_defaults(fn=cmd_layer_new)

    sp = lay.add_parser("import", help="PNG/JPG (alpha kept) into a new "
                                       "paint layer; Krita reads the file")
    sp.add_argument("file")
    sp.add_argument("--name", help="layer name (default: file name)")
    sp.add_argument("--x", type=int, default=None)
    sp.add_argument("--y", type=int, default=None)
    _place(sp)
    _look(sp)
    sp.add_argument("--hidden", action="store_true")
    sp.set_defaults(fn=cmd_layer_import)

    sp = lay.add_parser("export", help="layer pixels to a PNG with alpha "
                                       "(canvas-sized)")
    sp.add_argument("ref", metavar="REF", help=ref_help)
    sp.add_argument("path")
    sp.add_argument("--crop", action="store_true",
                    help="crop to the layer bounds instead of the canvas")
    sp.set_defaults(fn=cmd_layer_export)

    sp = lay.add_parser("set", help="rename / blend / opacity / visibility / locks")
    sp.add_argument("ref", metavar="REF", help=ref_help)
    sp.add_argument("--name", dest="rename", metavar="NEW_NAME")
    _look(sp)
    vis = sp.add_mutually_exclusive_group()
    vis.add_argument("--visible", dest="visible", action="store_const",
                     const=True, default=None)
    vis.add_argument("--hidden", dest="visible", action="store_const",
                     const=False)
    lock = sp.add_mutually_exclusive_group()
    lock.add_argument("--lock", dest="locked", action="store_const",
                      const=True, default=None)
    lock.add_argument("--unlock", dest="locked", action="store_const",
                      const=False)
    sp.add_argument("--alpha-lock", dest="alpha_locked",
                    action=argparse.BooleanOptionalAction, default=None)
    sp.add_argument("--inherit-alpha", dest="inherit_alpha",
                    action=argparse.BooleanOptionalAction, default=None,
                    help="clip to the layers below (Krita's alpha inheritance)")
    sp.set_defaults(fn=cmd_layer_set)

    sp = lay.add_parser("move", help="move a layer: --above/--below/--into/"
                                     "--top/--bottom")
    sp.add_argument("ref", metavar="REF", help=ref_help)
    _place(sp)
    sp.set_defaults(fn=cmd_layer_move)

    sp = lay.add_parser("select", help="make a layer the active one")
    sp.add_argument("ref", metavar="REF", help=ref_help)
    sp.set_defaults(fn=cmd_layer_select)

    sp = lay.add_parser("duplicate", help="copy a layer (above it by default)")
    sp.add_argument("ref", metavar="REF", help=ref_help)
    sp.add_argument("--name", help="default: '<name> copy'")
    _place(sp, "the copy")
    sp.set_defaults(fn=cmd_layer_duplicate)

    sp = lay.add_parser("delete", help="delete one or more layers")
    sp.add_argument("refs", metavar="REF", nargs="+", help=ref_help)
    sp.set_defaults(fn=cmd_layer_delete)

    sp = lay.add_parser("group", help="wrap layers in a new group: "
                                      "kri layer group NAME REF...")
    sp.add_argument("name")
    sp.add_argument("refs", metavar="REF", nargs="+", help=ref_help)
    _look(sp)
    sp.set_defaults(fn=cmd_layer_group)

    sp = lay.add_parser("fill", help="fill a paint layer with a colour "
                                     "(whole canvas, or --selection)")
    sp.add_argument("ref", metavar="REF", help=ref_help)
    sp.add_argument("color", metavar="HEX")
    sp.add_argument("--selection", action="store_true",
                    help="only inside the current selection")
    sp.set_defaults(fn=cmd_layer_fill)

    sam = sub.add_parser(
        "sam", help="SAM daemon (krita-autoselect) via the AI Select plugin"
    ).add_subparsers(dest="sam_cmd", required=True, metavar="sam-command")
    sp = sam.add_parser("status", help="is the daemon up? what AI Select manages")
    sp.set_defaults(fn=cmd_sam_status)
    sp = sam.add_parser("start", help="have AI Select start the daemon and "
                                      "wait until it answers")
    sp.add_argument("--no-wait", action="store_true", dest="no_wait")
    sp.add_argument("--timeout", type=float, default=SAM_START_TIMEOUT)
    sp.set_defaults(fn=cmd_sam_start)
    sp = sam.add_parser("stop", help="stop the daemon AI Select started")
    sp.set_defaults(fn=cmd_sam_stop)

    sp = sub.add_parser("colorspace", help="show the image colour space, or "
                                           "convert it: kri colorspace RGBA U8")
    sp.add_argument("model", nargs="?", help="RGBA, GRAYA, CMYKA, LABA, ...")
    sp.add_argument("depth", nargs="?", help="U8, U16, F16, F32 (default U8)")
    sp.add_argument("--profile", help="ICC profile name (default: sRGB/gray elle)")
    sp.set_defaults(fn=cmd_colorspace)

    ai = sub.add_parser("ai", help="AI Diffusion plugin").add_subparsers(
        dest="ai_cmd", required=True, metavar="ai-command")

    sp = ai.add_parser("status", help="AI state (connection/style/queue/prompt)")
    sp.set_defaults(fn=cmd_ai_status)

    sp = ai.add_parser("overview", help="raw ai_overview (kri status merges this)")
    sp.set_defaults(fn=cmd_ai_overview)

    sp = ai.add_parser("set-prompt")
    sp.add_argument("-p", "--positive")
    sp.add_argument("-n", "--negative")
    sp.set_defaults(fn=cmd_ai_set_prompt)

    sp = ai.add_parser("set-params")
    sp.add_argument("--style")
    sp.add_argument("--strength", type=float)
    sp.add_argument("--seed", type=int)
    sp.add_argument("--fixed-seed", action=argparse.BooleanOptionalAction,
                    dest="fixed_seed", default=None)
    sp.add_argument("--batch-count", type=int, dest="batch_count")
    sp.set_defaults(fn=cmd_ai_set_params)

    sp = ai.add_parser("workspace")
    sp.add_argument("name", choices=WORKSPACES)
    sp.set_defaults(fn=cmd_ai_workspace)

    sp = ai.add_parser("generate")
    sp.add_argument("--wait", action="store_true",
                    help="block until the job queue drains")
    sp.add_argument("--timeout", type=float, default=300.0)
    sp.add_argument("--poll", type=float, default=2.0,
                    help="seconds between status polls (with --wait)")
    sp.set_defaults(fn=cmd_ai_generate)

    sp = ai.add_parser("jobs")
    sp.add_argument("--state", choices=JOB_STATES, default="all")
    sp.add_argument("--limit", type=int, default=20)
    sp.set_defaults(fn=cmd_ai_jobs)

    sp = ai.add_parser("apply", help="apply a finished result to the canvas")
    sp.add_argument("--job-id", dest="job_id")
    sp.add_argument("--index", type=int, default=0)
    sp.set_defaults(fn=cmd_ai_apply)

    sp = ai.add_parser("cancel")
    sp.add_argument("--queued", action="store_true",
                    help="also cancel queued (not started) jobs")
    sp.set_defaults(fn=cmd_ai_cancel)

    sp = ai.add_parser("preview", help="save a result image without applying it")
    sp.add_argument("job_id")
    sp.add_argument("--index", type=int, default=0)
    sp.add_argument("--filename", default="")
    sp.set_defaults(fn=cmd_ai_preview)

    sp = ai.add_parser("styles")
    sp.add_argument("filter", nargs="?", default="")
    sp.add_argument("--limit", type=int, default=30)
    sp.set_defaults(fn=cmd_ai_styles)

    region = ai.add_parser("region", help="region masks").add_subparsers(
        dest="region_cmd", required=True)
    sp = region.add_parser("create")
    sp.add_argument("-p", "--positive", default="")
    sp.add_argument("--group", action="store_true")
    sp.set_defaults(fn=cmd_region_create)
    sp = region.add_parser("list")
    sp.set_defaults(fn=cmd_region_list)
    sp = region.add_parser("select", help="no index = select root")
    sp.add_argument("index", type=int, nargs="?")
    sp.add_argument("--layer-id", dest="layer_id")
    sp.set_defaults(fn=cmd_region_select)
    sp = region.add_parser("remove")
    sp.add_argument("index", type=int)
    sp.set_defaults(fn=cmd_region_remove)

    control = ai.add_parser("control", help="ControlNet / IP-Adapter layers"
                            ).add_subparsers(dest="control_cmd", required=True)
    sp = control.add_parser("add")
    sp.add_argument("mode", choices=CONTROL_MODES)
    sp.add_argument("--layer-id", dest="layer_id")
    sp.add_argument("--strength", type=float)
    sp.add_argument("--region", type=int)
    sp.set_defaults(fn=cmd_control_add)
    sp = control.add_parser("list")
    sp.add_argument("--region", type=int)
    sp.set_defaults(fn=cmd_control_list)
    sp = control.add_parser("set")
    sp.add_argument("index", type=int)
    sp.add_argument("--mode", choices=CONTROL_MODES)
    sp.add_argument("--strength", type=float)
    sp.add_argument("--region", type=int)
    sp.set_defaults(fn=cmd_control_set)
    sp = control.add_parser("remove")
    sp.add_argument("index", type=int)
    sp.add_argument("--region", type=int)
    sp.set_defaults(fn=cmd_control_remove)

    return p


def main():
    args = build_parser().parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
