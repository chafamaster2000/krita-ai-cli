#!/usr/bin/env python3
"""kri — CLI bridge to the kritamcp plugin running inside Krita.

JSON-over-HTTP to the plugin (default http://127.0.0.1:5678 — the literal
IP dodges Windows' 2s localhost->IPv6 fallback). Stdlib only, so every
invocation starts fast and there is no venv.

Env:
  KRITA_URL       plugin endpoint (default http://127.0.0.1:5678)
  KRITAMCP_TOKEN  shared token; must match the token set in Krita's env
  KRI_LOOK_PATH   override the default image path used by `kri look`

Exit codes: 0 ok · 1 plugin/connection error · 2 usage error.
"""
import argparse
import json
import os
import socket
import sys
import time

# base64/tempfile solo los usa `look` → import lazy en write_image/look_path.
# urllib.request costaba ~+55ms por invocación; el transporte es un socket
# crudo (el plugin habla HTTP plano en localhost, controlamos ambos lados).

KRITA_URL = os.environ.get("KRITA_URL", "http://127.0.0.1:5678")
TOKEN = os.environ.get("KRITAMCP_TOKEN", "")
# Daemon de segmentación (repo krita-autoselect) para `kri select sam`.
# Sin AUTOSELECT_URL explícita, kri adopta la URL que maneje el plugin
# AI Select de Krita cuando le pide arrancar el daemon.
AUTOSELECT_URL = os.environ.get("AUTOSELECT_URL", "http://127.0.0.1:5679")
AUTOSELECT_URL_EXPLICIT = "AUTOSELECT_URL" in os.environ
SAM_START_TIMEOUT = 200.0  # AI Select espera hasta 180 s el arranque

WORKSPACES = ["generation", "upscaling", "live", "animation", "custom"]
JOB_STATES = ["all", "queued", "executing", "finished", "cancelled"]
CONTROL_MODES = [
    "scribble", "line_art", "soft_edge", "canny_edge", "depth", "normal",
    "pose", "segmentation", "blur", "stencil",
    "reference", "style", "composition", "face",
]


def _endpoint(url):
    """host, port, base_path from a URL (no urllib.parse: too heavy)."""
    rest = url.split("://", 1)[-1]
    hostport, _, path = rest.partition("/")
    host, _, port = hostport.partition(":")
    return host, int(port or 80), "/" + path if path else ""


def http_request(method, path, body=None, timeout=30.0, url=None, hint=None):
    """Minimal HTTP/1.1 over a raw socket. `Connection: close` + read-to-EOF
    keeps it correct against both HTTP/1.0 and 1.1 servers. Returns the
    parsed JSON body regardless of status code (the server puts errors in
    the body), or an {"error": ...} dict on transport failure.

    `url` defaults to the Krita plugin; `hint` customizes the connection
    error for other services (e.g. the krita-autoselect daemon)."""
    if url is None:
        url = KRITA_URL
        hint = hint or "is Krita running with the kritamcp plugin?"
    host, port, base = _endpoint(url)
    lines = [
        f"{method} {(base + path) or '/'} HTTP/1.1",
        f"Host: {host}:{port}",
        "Connection: close",
        "Content-Type: application/json",
    ]
    if TOKEN:
        lines.append(f"X-Kritamcp-Token: {TOKEN}")
    payload = body if body is not None else b""
    lines.append(f"Content-Length: {len(payload)}")
    raw = ("\r\n".join(lines) + "\r\n\r\n").encode() + payload
    try:
        with socket.create_connection((host, port), timeout=timeout) as s:
            s.sendall(raw)
            chunks = []
            while True:
                chunk = s.recv(65536)
                if not chunk:
                    break
                chunks.append(chunk)
    except (ConnectionError, socket.gaierror, socket.timeout, OSError) as e:
        suffix = f" — {hint}" if hint else ""
        return {"error": f"Cannot connect to {url}{suffix} ({e})",
                "unreachable": True}
    response = b"".join(chunks)
    head, _, resp_body = response.partition(b"\r\n\r\n")
    try:
        status = int(head.split(None, 2)[1])
    except (IndexError, ValueError):
        return {"error": f"Malformed HTTP response from {url}"}
    try:
        return json.loads(resp_body.decode())
    except Exception:
        return {"error": f"HTTP {status} from {url} (non-JSON body)"}


def send(action, params=None, timeout=30.0):
    """POST one command. The timeout also travels in the body so the plugin
    stops waiting just before we would (same contract server.py used)."""
    body = json.dumps(
        {"action": action, "params": params or {}, "timeout": timeout}
    ).encode()
    return http_request("POST", "", body, timeout=timeout)


def out(result):
    """Print result as JSON and exit. Errors go to stderr with exit code 1 so
    `kri a && kri b` chains stop at the first failure."""
    text = json.dumps(result, indent=1, default=str)
    if isinstance(result, dict) and result.get("error"):
        print(text, file=sys.stderr)
        sys.exit(1)
    print(text)
    sys.exit(0)


def clean(**params):
    """Drop None values so the plugin's own defaults apply."""
    return {k: v for k, v in params.items() if v is not None}


def write_image(payload, path):
    """Decode a plugin canvas payload (data_b64) to a file; return summary."""
    import base64
    raw = base64.b64decode(payload["data_b64"])
    with open(path, "wb") as f:
        f.write(raw)
    return {"path": path, "width": payload.get("width"),
            "height": payload.get("height"), "format": payload.get("format")}


def look_path(payload, override):
    if override:
        return override
    ext = "png" if payload.get("format") == "png" else "jpg"
    if os.environ.get("KRI_LOOK_PATH"):
        return os.environ["KRI_LOOK_PATH"]
    import tempfile
    return os.path.join(tempfile.gettempdir(), f"kri-canvas.{ext}")


def parse_points(tokens):
    pts = []
    for t in tokens:
        try:
            x, y = t.split(",")
            pts.append([int(x), int(y)])
        except ValueError:
            print(f"kri: invalid point '{t}' (expected X,Y)", file=sys.stderr)
            sys.exit(2)
    return pts


def read_source(file_arg):
    if file_arg == "-":
        return sys.stdin.read()
    with open(file_arg) as f:
        return f.read()


