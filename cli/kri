def sam_ensure(timeout=SAM_START_TIMEOUT):
    """Ask the AI Select plugin (inside Krita, via kritamcp) to reuse or start
    its SAM daemon and wait until it answers. Returns (url, None) or
    (None, reason). Without an explicit AUTOSELECT_URL, the daemon's URL is
    whatever AI Select is configured with."""
    params = {"url": AUTOSELECT_URL} if AUTOSELECT_URL_EXPLICIT else {}
    st = send("sam_start", params, timeout=15.0)
    if not isinstance(st, dict) or st.get("error"):
        return None, (st or {}).get("error", "sam_start failed")
    seq = st.get("seq")
    if seq is None:  # plugin too old to know sam_start
        return None, "kritamcp plugin cannot start the SAM daemon (update it)"
    deadline = time.time() + timeout
    while time.time() < deadline:
        time.sleep(0.5)
        res = send("sam_status", timeout=10.0)
        if not isinstance(res, dict) or res.get("error"):
            return None, (res or {}).get("error", "sam_status failed")
        start = res.get("start") or {}
        if start.get("seq") == seq and start.get("done"):
            if start.get("ok"):
                return st.get("url") or AUTOSELECT_URL, None
            return None, start.get("message") or res.get("detail") or "failed"
    return None, f"SAM daemon not ready after {timeout:.0f}s"


def daemon_health(url):
    res = http_request("GET", "/health", timeout=3.0, url=url)
    if not isinstance(res, dict) or res.get("error"):
        return {"url": url, "reachable": False,
                "error": (res or {}).get("error")}
    return {"url": url, "reachable": True,
            **{k: v for k, v in res.items() if k != "status"}}


def cmd_sam_status(a):
    plugin = send("sam_status", {"url": AUTOSELECT_URL}, timeout=10.0)
    if isinstance(plugin, dict):
        plugin.pop("status", None)
        plugin.pop("unreachable", None)
    out({"status": "ok", "daemon": daemon_health(AUTOSELECT_URL),
         "ai_select": plugin})


def cmd_sam_start(a):
    if a.no_wait:
        params = {"url": AUTOSELECT_URL} if AUTOSELECT_URL_EXPLICIT else {}
        out(send("sam_start", params, timeout=15.0))
    url, err = sam_ensure(a.timeout)
    if err:
        out({"error": f"SAM daemon not started: {err}"})
    out({"status": "ok", "daemon": daemon_health(url)})


