def cmd_select_sam(a):
    """Canvas → daemon krita-autoselect (SAM 3) → selección en Krita.
    Con --to-layer, además una capa nueva rellena dentro de la selección."""
    global AUTOSELECT_URL
    if not a.text and not a.point and not a.box and not a.within:
        print("kri: provide a prompt: TEXT, --point, --box and/or --within",
              file=sys.stderr)
        sys.exit(2)
    if a.to_layer and a.list:
        print("kri: --to-layer and --list don't go together", file=sys.stderr)
        sys.exit(2)
    canvas = send("get_canvas", {"mode": "full"}, timeout=120.0)
    if not isinstance(canvas, dict) or canvas.get("error"):
        out(canvas)

    points, labels = [], []
    for token in (a.point or []):
        points.append(parse_points([token])[0])
        labels.append(1)
    for token in (a.neg_point or []):
        points.append(parse_points([token])[0])
        labels.append(0)

    payload = json.dumps(clean(
        image_b64=canvas["data_b64"],
        text=a.text,
        points=points or None,
        point_labels=labels if points else None,
        box=list(a.box) if a.box else None,
        within=list(a.within) if a.within else None,
        threshold=a.threshold,
        combine="union" if a.instance is None else a.instance,
        list_only=True if a.list else None,
    )).encode()
    hint = ("is the krita-autoselect daemon running? Start it from the "
            "AI Select (SAM) docker in Krita, or `kri sam start`")

    def segment():
        return http_request("POST", "/segment", payload, timeout=a.timeout,
                            url=AUTOSELECT_URL, hint=hint)

    res = segment()
    if isinstance(res, dict) and res.get("unreachable"):
        # Daemon caído: que AI Select (dentro de Krita) lo arranque.
        url, err = sam_ensure()
        if url:
            AUTOSELECT_URL = url
            res = segment()
        else:
            res["error"] += f" [auto-start via AI Select failed: {err}]"
    if not isinstance(res, dict) or res.get("error") or a.list:
        out(res)
    if not res.get("count") or not res.get("mask_b64"):
        out({"error": "no instances found for that prompt",
             "instances": res.get("instances", [])})

    apply = {"action": "select_from_mask",
             "params": {"mask_b64": res["mask_b64"], "mode": a.mode}}
    result = {"status": "ok", "count": res["count"],
              "instances": res["instances"]}
    if a.to_layer:
        layer = {"action": "layer_new", "params": clean(
            name=a.to_layer, color=a.color or "#ffffff", selection=True,
            blend=a.blend,
            opacity=a.opacity, **placement(a))}
        batch = send("batch", {"commands": [apply, layer],
                               "stop_on_error": True}, timeout=120.0)
        if not isinstance(batch, dict) or batch.get("error"):
            out(batch)
        results = batch.get("results") or [{}]
        if batch.get("stopped_at") is not None:
            out({**results[-1], "step": ["select_from_mask", "layer_new"]
                 [batch["stopped_at"]]})
        result["selection"] = results[0].get("selection")
        result["layer"] = results[1].get("layer")
        if results[1].get("warning"):
            result["warning"] = results[1]["warning"]
    else:
        applied = send(apply["action"], apply["params"])
        if not isinstance(applied, dict) or applied.get("error"):
            out(applied)
        result["selection"] = applied.get("selection")
    if a.save_mask:
        on = result["layer"]["id"] if a.to_layer else None
        saved = send("select_save", clean(name=a.save_mask, on=on))
        if not isinstance(saved, dict) or saved.get("error"):
            out({**saved, "partial": result})
        result["mask"] = saved.get("mask")
    out(result)


